<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="
   http://www.liquibase.org/xml/ns/dbchangelog
   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    
    <!--Пользователи-->
    <changeSet id="1-add-users" author="maxonkizino">

        <createTable tableName="users">

            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="surname" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="birth_date" type="DATE"/>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>

            <column name="active" type="BOOLEAN" defaultValueBoolean="true"/>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP"/>


        </createTable>
        
    </changeSet>

    <changeSet id="2-add-payment-cards" author="maxonkizino" >
        <createTable tableName="payment_cards">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints nullable="false" primaryKey="true"></constraints>
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"></constraints>
            </column>

            <column name="number" type="varchar(20)">
                <constraints nullable="false"></constraints>
            </column>

            <column name="holder" type="varchar(255)">
                <constraints nullable="false"></constraints>
            </column>

            <column name="expiration_date" type="date">
                <constraints nullable="false"></constraints>
            </column>

            <column name="active" type="boolean">
                <constraints nullable="false"></constraints>
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP"/>


        </createTable>

    </changeSet>

    <changeSet id="3-users-payment-cards-constraint" author="maxonkizino">
        <addForeignKeyConstraint
                baseTableName="payment_cards"
                baseColumnNames="user_id"

                referencedTableName="users"
                referencedColumnNames="id"
                constraintName="fk_cards_users"/>
    </changeSet>


    <changeSet id="4-users-index" author="maxonkizino">
        <createIndex tableName="users" indexName="users_email_index">
            <column name="email"> </column>
        </createIndex>
    </changeSet>

    <changeSet id="5-payment-cards-index" author="maxonkizino">
        <createIndex tableName="payment_cards" indexName="payment_cards_user_id_index">
            <column name="user_id"> </column>
        </createIndex>
    </changeSet>
    
    
</databaseChangeLog>